(use-modules (curl) (ice-9 ftw) (ice-9 threads) (srfi srfi-13) (srfi srfi-64))
(test-begin "thread-local error state")
(setenv "no_proxy" "127.0.0.1,localhost")
(setenv "NO_PROXY" "127.0.0.1,localhost")
(let* ((dir (mkdtemp "/tmp/guile-curl-thread-errors.XXXXXX"))
       (file (string-append dir "/ok"))
       (out (open-file file "w")))
  (display "ok" out)
  (close-port out)
  (let* ((pid (primitive-fork))
         (child? (= pid 0)))
    (when child?
      (execlp "guile" "guile" "test/support/range-server.scm"
              "--root" dir "--port" "18081"))
    (unless child?
      (usleep 500000)
      (let ((failed #f) (lock (make-mutex)))
        (define refused
          (call-with-new-thread
           (lambda ()
             (let ((h (curl-easy-init)))
               (curl-easy-setopt h 'url "http://127.0.0.1:1/" )
               (do ((i 0 (+ i 1))) ((= i 50))
                 (curl-easy-perform h)
                 (let ((code (curl-error-code)) (message (curl-error-string)))
                   (unless (and (= code CURLE_COULDNT_CONNECT)
                                (not (string-null? message)))
                     (format (current-error-port) "refused mismatch ~a ~s~%" code message)
                     (with-mutex lock (set! failed #t)))))
               (curl-easy-cleanup h)))))
        (define valid
          (call-with-new-thread
           (lambda ()
             (let ((h (curl-easy-init)))
               (curl-easy-setopt h 'url "http://127.0.0.1:18081/ok")
               (do ((i 0 (+ i 1))) ((= i 50))
                 (curl-easy-perform h)
                 (let ((code (curl-error-code)) (message (curl-error-string)))
                   (unless (= code 0)
                     (format (current-error-port) "valid mismatch ~a ~s~%" code message)
                     (with-mutex lock (set! failed #t)))))
               (curl-easy-cleanup h)))))
        (join-thread refused)
        (join-thread valid)
        (test-assert "two threads retain independent error state" (not failed)))
      (kill pid SIGTERM)
      (waitpid pid))
  (delete-file file)
  (rmdir dir)))
(test-end "thread-local error state")
